<style>
  :root {
    --navy:    #002B45;
    --gold:    #C6A664;
    --gold-lt: #E1C77F;
    --gray-bg: #f5f5f5;
    --text-md: rgba(0,43,69,0.75);
  }

  /* Section & Blobs */
  .sample-properties {
    position: relative;
    padding: 8rem 2rem;
    background: #fff;
    overflow: hidden;
  }
  .sample-properties .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.3;
    animation: float 8s ease-in-out infinite;
  }
  .sample-properties .blob--1 {
    width: 400px; height: 400px;
    background: var(--gold);
    top: -100px; left: -100px;
  }
  .sample-properties .blob--2 {
    width: 500px; height: 500px;
    background: var(--navy);
    bottom: -150px; right: -150px;
    animation-duration: 9s;
  }

  /* Content Wrapper */
  .sample-properties .sp-content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  /* Title */
  .sample-properties .sp-title {
    font-size: 3.2rem;
    font-weight: 800;
    background: linear-gradient(120deg, var(--gold), var(--gold-lt), var(--gold));
    background-size: 200% auto;
    color: transparent;
    -webkit-background-clip: text;
            background-clip: text;
    animation: shimmer 4s linear infinite;
    margin: 0 0 2rem;
  }

  /* Grid & Cards */
  .sample-properties .sp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px,1fr));
    gap: 2rem;
    margin-top: 0;
  }
  .sample-properties .sp-card {
    position: relative;
    height: 320px;
    border-radius: 20px;
    overflow: hidden;
    background: var(--gray-bg);
    box-shadow: 0 8px 24px rgba(0,0,0,0.05);
    transition: transform .4s ease, box-shadow .4s ease;
    cursor: pointer;
  }
  .sample-properties .sp-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 16px 40px rgba(0,0,0,0.12);
  }
  .sample-properties .sp-card__img {
    width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    transition: transform .6s ease;
  }
  .sample-properties .sp-card:hover .sp-card__img {
    transform: scale(1.1);
  }
  .sample-properties .sp-card__label {
    position: absolute;
    bottom: 1rem; left: 50%;
    transform: translateX(-50%);
    background: rgba(255,255,255,0.9);
    padding: .6rem 1.2rem;
    border-radius: 12px;
    font-weight: 600;
    color: var(--navy);
    font-size: 1.1rem;
  }

  /* Animations */
  @keyframes shimmer {
    0%,100% { background-position: -100% 0; }
    50%     { background-position: 100% 0; }
  }
  @keyframes float {
    0%,100% { transform: translate(0,0); }
    50%     { transform: translate(20px,-20px); }
  }
</style>

<section class="sample-properties">
  <!-- decorative blobs -->
  <div class="blob blob--1"></div>
  <div class="blob blob--2"></div>

  <div class="sp-content">
    <header class="sp-header">
      <h2 class="sp-title">Sample Properties</h2>
    </header>

    <div class="sp-grid">
      <div class="sp-card industrial">
        <div class="sp-card__img"></div>
        <div class="sp-card__label">Industrial</div>
      </div>
      <div class="sp-card multifamily">
        <div class="sp-card__img"></div>
        <div class="sp-card__label">Multifamily</div>
      </div>
      <div class="sp-card storage">
        <div class="sp-card__img"></div>
        <div class="sp-card__label">Self-Storage</div>
      </div>
    </div>
  </div>
</section>
